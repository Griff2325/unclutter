{
  "name": "unclutter",
  "version": "0.4.0-beta.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Griff2325/unclutter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --import tsx --test tests/*.test.ts scripts/*.test.mjs",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "build:safari": "wxt build -b safari --mv3",
    "zip:safari": "wxt zip -b safari --mv3",
    "safari:app": "bun run build:safari && node scripts/package-safari.mjs",
    "safari:release": "bun run build:safari && node scripts/release-safari.mjs",
    "ios:app": "bun run build:safari && node scripts/package-ios.mjs",
    "ios:device": "bun run build:safari && IOS_DEVICE_BUILD=1 node scripts/package-ios.mjs"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "wxt": "0.21.4"
  }
}
